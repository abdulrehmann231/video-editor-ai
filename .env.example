# ---- Cloudflare R2 (S3-compatible) ----
# Endpoint is the account URL WITHOUT the bucket path, e.g.
#   https://a424212c7b5c541fff555ae41c7f7ffd.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edit-ai
# Custom public domain that serves the bucket (no scheme), e.g. videos.abdulrehmann.com
R2_PUBLIC_HOST=videos.abdulrehmann.com

# ---- Gemini (editorial brain) ----
# Comma-separated list of API keys; the app round-robins across them and fails over on 429.
GEMINI_API_KEYS=
# Optional model override. Default (gemini-flash-latest) works across accounts;
# pinned 2.x models can be blocked for newer API projects.
GEMINI_MODEL=gemini-flash-latest

# ---- Pexels (stock b-roll) ----
# NOTE: exact name is singular — PEXEL_API_KEY
PEXEL_API_KEY=

# ---- Rendering backend ----
# local (default) = render on this machine's headless Chrome.
# lambda = render in parallel on AWS Lambda (fast, scales). See DEPLOY-LAMBDA.md.
RENDER_BACKEND=local
# Only needed when RENDER_BACKEND=lambda (fill via `npm run lambda:deploy`):
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
# Optional: local render fetch timeout (ms) for large base videos
# REMOTION_TIMEOUT_MS=180000
