                      "expr": {
                        "text": "var f=\"BUT IT PROVES ONE THING...\";var n=Math.max(0,Math.floor((time-38.9)*26));var s=f.substring(0,Math.min(n,f.length));s+=((Math.floor(time*3)%2==0)||n<f.length)?\"_\":\" \";s;",
                        "enabled": true
                      },
