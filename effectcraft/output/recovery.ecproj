                      "expr": {
                        "text": "var f=\"PERSISTENT SORENESS\";var t0=1.769999999999996;var n=Math.floor((time-t0)*34);var ch=\"0123456789#%$@&ABCDEFGHJKLMNPQRSTUVWXYZ\";var s=\"\";if(time<t0){s=\"\";}else{for(var i=0;i<f.length;i++){var c=f.charAt(i);if(c==\" \"||c==\"\\r\"){s+=c;continue;}if(i<n-3){s+=c;}else if(i<n){seedRandom(i*13+Math.floor(time*30),true);s+=ch.charAt(Math.floor(random(ch.length)));}else{s+=\"\";}}}s;",
                        "enabled": true
                      },
